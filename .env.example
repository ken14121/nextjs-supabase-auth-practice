# Supabase の接続情報（Supabase の画面上部「Connect」→ App Frameworks → Next.js で確認できる）
# このファイルを .env.local にコピーして値を入れる。.env.local はコミットしない。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Jev（TypeSafe AI）の API キー。サーバー側（Server Action）でだけ使うので NEXT_PUBLIC_ を付けない。
# Zendash から DM で共有されたもの。チャット・Slack の公開チャンネル・GitHub には貼らない。
JEV_API_KEY=

# Jev を使ってよいアカウント（自分）の Supabase のユーザー ID。カンマ区切りで複数書ける。
# 書いていないと、だれも Jev を使わず、アプリのルールで判定する（公開サイトでクレジットを使いすぎないため）。
# ユーザー ID は Supabase の画面の Authentication → Users で確認できる。
JEV_OWNER_USER_IDS=
